{
  "name": "@nostr-paywall/protocol",
  "version": "0.1.1",
  "description": "이벤트 단위 유료 nostr 릴레이 — 과금 술어·NIP-11 파서·EVENT 봉투·OK 규약. 릴레이와 클라가 공유하는 순수 로직.",
  "keywords": [
    "nostr",
    "relay",
    "paywall",
    "micropayment",
    "nip-11",
    "cashu"
  ],
  "type": "module",
  "main": "./dist/cjs/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajava2006/nostr-paywall.git",
    "directory": "packages/protocol"
  },
  "homepage": "https://github.com/tajava2006/nostr-paywall#readme",
  "bugs": {
    "url": "https://github.com/tajava2006/nostr-paywall/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/protocol",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/protocol"
  },
  "module": "./dist/esm/index.js"
}
