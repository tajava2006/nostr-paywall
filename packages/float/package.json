{
  "name": "@nostr-paywall/float",
  "version": "0.1.3",
  "description": "이벤트 단위 유료 nostr 릴레이 — 클라 ecash float. NWC 로 충전하고 이벤트당 1 sat 씩 쓴다.",
  "keywords": [
    "nostr",
    "paywall",
    "cashu",
    "ecash",
    "nwc",
    "micropayment"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajava2006/nostr-paywall.git",
    "directory": "packages/float"
  },
  "homepage": "https://github.com/tajava2006/nostr-paywall#readme",
  "bugs": {
    "url": "https://github.com/tajava2006/nostr-paywall/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/float",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/float"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.10.1",
    "@nostr-paywall/client": "workspace:*",
    "@nostr-paywall/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/ws": "^8.18.1",
    "nostr-tools": "^2.25.2",
    "ws": "^8.21.3"
  }
}
