{
  "name": "@nostr-paywall/relay-guard",
  "version": "0.1.3",
  "description": "이벤트 단위 유료 nostr 릴레이 — 결제 원장(node:sqlite)과 가드. 훅 비의존이라 어느 릴레이 구현에도 얹힌다.",
  "keywords": [
    "nostr",
    "relay",
    "paywall",
    "micropayment",
    "cashu",
    "sqlite"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.5.0"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajava2006/nostr-paywall.git",
    "directory": "packages/relay-guard"
  },
  "homepage": "https://github.com/tajava2006/nostr-paywall#readme",
  "bugs": {
    "url": "https://github.com/tajava2006/nostr-paywall/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/relay-guard",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/relay-guard"
  },
  "dependencies": {
    "@nostr-paywall/protocol": "workspace:*",
    "@nostr-paywall/collectors": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24"
  }
}
