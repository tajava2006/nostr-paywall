{
  "name": "@nostr-paywall/client",
  "version": "0.1.3",
  "description": "이벤트 단위 유료 nostr 릴레이 — 클라이언트. SimplePool 드롭인 교체로 결제 봉투를 자동 첨부한다.",
  "keywords": [
    "nostr",
    "relay",
    "paywall",
    "micropayment",
    "cashu",
    "nostr-tools"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajava2006/nostr-paywall.git",
    "directory": "packages/client"
  },
  "homepage": "https://github.com/tajava2006/nostr-paywall#readme",
  "bugs": {
    "url": "https://github.com/tajava2006/nostr-paywall/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/client",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/client"
  },
  "dependencies": {
    "@nostr-paywall/protocol": "workspace:*"
  },
  "peerDependencies": {
    "nostr-tools": ">=2"
  },
  "devDependencies": {
    "@types/ws": "^8.18.1",
    "nostr-tools": "^2.7.2",
    "ws": "^8.21.3"
  }
}
