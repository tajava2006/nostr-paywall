{
  "name": "@nostr-paywall/collectors",
  "version": "0.1.3",
  "description": "이벤트 단위 유료 nostr 릴레이 — 레일별 수납 어댑터(Cashu). 민트 수수료 부팅 게이트 포함.",
  "keywords": [
    "nostr",
    "relay",
    "paywall",
    "cashu",
    "ecash",
    "micropayment"
  ],
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "main": "./dist/cjs/index.js",
  "module": "./dist/esm/index.js",
  "types": "./dist/esm/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/esm/index.d.ts",
      "import": "./dist/esm/index.js",
      "require": "./dist/cjs/index.js",
      "default": "./dist/esm/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tajava2006/nostr-paywall.git",
    "directory": "packages/collectors"
  },
  "homepage": "https://github.com/tajava2006/nostr-paywall#readme",
  "bugs": {
    "url": "https://github.com/tajava2006/nostr-paywall/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc --noEmit",
    "smoke": "node scripts/smoke-cashu.ts",
    "build": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/collectors",
    "prepublishOnly": "tsc -p tsconfig.build.json && tsc -p tsconfig.cjs.json && node ../../scripts/fix-cjs.mjs packages/collectors"
  },
  "dependencies": {
    "@cashu/cashu-ts": "^4.10.1",
    "@nostr-paywall/protocol": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^24.13.3"
  }
}
